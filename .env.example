# Environment variables are read from your shell; this file is documentation.
# For a local .env file use: node --env-file=.env src/server.js
HOST=127.0.0.1
PORT=3000
YYC_DATA_DIR=./data
# Set an exact browser origin behind a reverse proxy, e.g. https://yyc.example.com
# PUBLIC_ORIGIN=https://yyc.example.com
# Set production only behind HTTPS; cookies become Secure.
# NODE_ENV=production
